# Copy these into Railway → your web service → Variables.

# Your landlord sign-in. The account is created the first time the app starts.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=choose-a-long-password

# Optional: a long random string that protects sign-in cookies. If left out, the app makes one and stores it in the database.
SESSION_SECRET=

# Tells the app it is live (secure cookies, caching).
NODE_ENV=production

# Railway fills this in when you reference the Postgres database: ${{Postgres.DATABASE_URL}}
DATABASE_URL=

# Optional: your web address, used in tenant invitation links, e.g. https://theoldmill.co.uk
PUBLIC_URL=

# Optional: set to true for one deploy to change the landlord password to ADMIN_PASSWORD, then remove it.
ADMIN_RESET_PASSWORD=
